#!/bin/sh
# What the package costs a request, measured instead of claimed.
#   ./bin/bench          PHP 7.4 and 8.3
#   ./bin/bench 8.4      one version
#
# It times everything the package does while a request is running: the query listener, the line
# of application code behind each query, and building the trace. What is left — encoding the
# payload and handing it to the agent — happens after the response has left (see the README).
set -eu
cd "$(dirname "$0")/.."

for php in ${*:-7.4 8.3}; do
	docker run --rm -v "$(pwd)":/pkg -w /pkg "php:$php-cli" php -r '
foreach (["OriginFinder", "Sender", "NullSender", "Tracer"] as $class) { require "/pkg/src/$class.php"; }

$tracer = new Slowpoke\Laravel\Tracer(
    new Slowpoke\Laravel\OriginFinder("/app", 60, ["vendor/", "storage/framework/views/"]),
    function () { return new Slowpoke\Laravel\NullSender(); },
    ["service" => "app", "max_queries" => 500, "max_sql_length" => 10000]
);

// A stack as deep as a controller calling a model calling the query builder.
function deep(int $n, callable $f) { return $n > 0 ? deep($n - 1, $f) : $f(); }
$sql = "select * from orders where customer_id = ? and status = ? order by created_at desc limit ?";
$runs = 3000;
$queries = 50;

$best = INF;
for ($round = 0; $round < 3; $round++) {
    $t = microtime(true);
    for ($i = 0; $i < $runs; $i++) {
        $tracer->startRequest("GET", microtime(true));
        for ($q = 0; $q < $queries; $q++) {
            deep(10, function () use ($tracer, $sql) { $tracer->recordQuery($sql, 1.5, "mysql"); });
        }
        $tracer->finishRequest("/orders/{id}", "/orders/7", 200);
        $tracer->reset();
    }
    $best = min($best, (microtime(true) - $t) / $runs * 1000);
}
printf("PHP %-7s %.2f ms on a request with %d queries · %.1f microseconds per query\n",
    PHP_VERSION, $best, $queries, $best * 1000 / $queries);
'
done
