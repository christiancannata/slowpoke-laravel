{
    "name": "slowpoke/laravel",
    "description": "Sends each Laravel request and job, with the file:line origin of every query, to the local Slowpoke agent.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "performance",
        "n-plus-one",
        "opentelemetry",
        "slowpoke"
    ],
    "homepage": "https://github.com/christiancannata/slowpoke-laravel",
    "authors": [
        {
            "name": "Christian Cannata",
            "email": "christiancannata@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/christiancannata/slowpoke-laravel/issues",
        "source": "https://github.com/christiancannata/slowpoke-laravel"
    },
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/contracts": "^5.8.35|^6.20.26|^7.30.6|^8.75|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^5.8.35|^6.20.26|^7.30.6|^8.75|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^5.8.35|^6.20.26|^7.30.6|^8.75|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^3.8|^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^8.5.52|^9.6|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Slowpoke\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slowpoke\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Slowpoke\\Laravel\\SlowpokeServiceProvider"
            ]
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
